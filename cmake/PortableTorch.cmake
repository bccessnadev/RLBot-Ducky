# Windows import-library linking follows GGLBot's bob-gpu build.
# It also works with clang-cl in Bob without installing the Windows CUDA toolkit in Linux.
# https://github.com/SubparN0va/GGLBot/blob/bob-gpu/CMakeLists.txt
function(rocketforge_link_portable_torch target)
    if(NOT DEFINED LIBTORCH_ROOT)
        if(RLBOT_USE_GPU)
            set(runtime_variable LIBTORCH_CUDA_ROOT)
            set(runtime_subdir libtorch)
        else()
            set(runtime_variable LIBTORCH_CPU_ROOT)
            set(runtime_subdir torch-archive/torch)
        endif()
        if(DEFINED ${runtime_variable})
            set(LIBTORCH_ROOT "${${runtime_variable}}")
        elseif(DEFINED ENV{${runtime_variable}} AND NOT "$ENV{${runtime_variable}}" STREQUAL "")
            set(LIBTORCH_ROOT "$ENV{${runtime_variable}}")
        elseif(WIN32)
            set(LIBTORCH_ROOT "$ENV{LOCALAPPDATA}/RLBot5/bots/${runtime_subdir}")
        elseif(DEFINED ENV{XDG_DATA_HOME} AND NOT "$ENV{XDG_DATA_HOME}" STREQUAL "")
            set(LIBTORCH_ROOT "$ENV{XDG_DATA_HOME}/RLBot5/bots/${runtime_subdir}")
        else()
            set(LIBTORCH_ROOT "$ENV{HOME}/.local/share/RLBot5/bots/${runtime_subdir}")
        endif()
    endif()

    message(STATUS "RLBot submission: ${RLBOT_DEVICE}, LibTorch: ${LIBTORCH_ROOT}")

    if(WIN32)
        if(CMAKE_BUILD_TYPE STREQUAL "Debug")
            message(FATAL_ERROR "Shared LibTorch requires Release or RelWithDebInfo.")
        endif()
        set(libraries torch torch_cpu c10)
        if(RLBOT_USE_GPU)
            list(APPEND libraries torch_cuda c10_cuda)

            # Force torch_cuda's registration even though inference's public API lives in torch_cpu.
            # RLBot inference is eager (no CUDA graphs), so the package needs no CUDA toolkit headers or cudart import library.
            target_link_options(${target} INTERFACE "/INCLUDE:?warp_size@cuda@at@@YAHXZ")
        endif()

        foreach(library IN LISTS libraries)
            if(NOT EXISTS "${LIBTORCH_ROOT}/lib/${library}.lib")
                message(FATAL_ERROR "Missing ${LIBTORCH_ROOT}/lib/${library}.lib. Run scripts/build_bob.py or set LIBTORCH_ROOT to the selected SDK.")
            endif()
            target_link_libraries(${target} PUBLIC "${LIBTORCH_ROOT}/lib/${library}.lib")
        endforeach()

        target_include_directories(${target} SYSTEM PUBLIC "${LIBTORCH_ROOT}/include" "${LIBTORCH_ROOT}/include/torch/csrc/api/include")
        target_compile_definitions(${target} PUBLIC USE_DISTRIBUTED USE_C10D_GLOO)
        target_compile_options(${target} PUBLIC /permissive- /EHsc /bigobj)
    else()
        set(Torch_DIR "${LIBTORCH_ROOT}/share/cmake/Torch")
        find_package(Torch REQUIRED CONFIG)
        target_include_directories(${target} SYSTEM PUBLIC ${TORCH_INCLUDE_DIRS})
        target_link_libraries(${target} PUBLIC ${TORCH_LIBRARIES})
        separate_arguments(torch_options NATIVE_COMMAND "${TORCH_CXX_FLAGS}")
        target_compile_options(${target} PUBLIC ${torch_options})
    endif()
endfunction()
